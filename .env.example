LLAMA_SERVER_URL=http://127.0.0.1:8080/v1/chat/completions
# Use the default host.docker.internal URL for a local server. On the Mac,
# set this to the Windows Tailscale URL when Qwen runs on the Windows PC.
LLAMA_SERVER_DOCKER_URL=http://host.docker.internal:8080/v1/chat/completions
LLAMA_MODEL=local-qwen
ROUTER_MAX_TOKENS=100
ROUTER_THINKING_BUDGET=0
SUPPORT_MAX_TOKENS=256
SUPPORT_THINKING_BUDGET=64

LANGFUSE_PUBLIC_KEY=replace_me
LANGFUSE_SECRET_KEY=replace_me
LANGFUSE_BASE_URL=https://cloud.langfuse.com

OPENAI_API_KEY=replace_with_a_strong_key
WEBUI_SECRET_KEY=replace_with_a_long_random_secret
OPEN_WEBUI_PORT=3001
